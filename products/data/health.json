{
  "id": "health",
  "title": "Health Insurance",
  "asOf": "Oct 2026",
  "intro": "Health insurance pays your hospital bills; what matters most is how reliably the insurer pays claims, how many hospitals offer cashless care, and limits like room rent caps and waiting periods.",
  "newsQuery": "health insurance India IRDAI",
  "sources": [
    "IRDAI Annual Report 2024-25 (Statement 12, solvency ratios as at 31 Mar 2025)",
    "Ditto Health Insurance Data Lab (Sep 2026), compiled from IRDAI annual reports and insurer public disclosures (NL forms)",
    "Ditto plan reviews and comparisons (Oct 2026)",
    "New India Mediclaim Policy customer information sheet (UIN NIAHLIP25040V102425)",
    "Insurer websites (Oct 2026)"
  ],
  "groups": [
    {
      "id": "claims",
      "label": "Claims record"
    },
    {
      "id": "strength",
      "label": "Size and strength"
    },
    {
      "id": "cost",
      "label": "Cost"
    },
    {
      "id": "cover",
      "label": "Cover features"
    }
  ],
  "params": [
    {
      "k": "csr",
      "label": "Claim settlement ratio",
      "fmt": "pct",
      "better": "high",
      "w": 3,
      "g": "claims",
      "tip": "Health claims settled within 3 months, FY2025-26 (insurer public disclosures via Ditto). Above 100% means older pending claims were cleared."
    },
    {
      "k": "icr",
      "label": "Incurred claim ratio",
      "fmt": "pct",
      "better": null,
      "w": 1,
      "g": "claims",
      "tip": "Claims paid as % of premium earned, FY2024-25 health (IRDAI/disclosures via Ditto). Not scored: very low can mean stingy payouts, above 100% can mean losses and future price hikes."
    },
    {
      "k": "complaints",
      "label": "Complaints per 10,000 claims",
      "fmt": "num",
      "better": "low",
      "w": 2,
      "g": "claims",
      "tip": "Health complaints per 10,000 claims, FY2025-26 (insurer public disclosures via Ditto). Lower is better."
    },
    {
      "k": "network",
      "label": "Network hospitals",
      "fmt": "num",
      "better": "high",
      "w": 1,
      "g": "strength",
      "tip": "Cashless hospitals as stated by insurer (Ditto, Sep 2026). Figures are 'X+'."
    },
    {
      "k": "solvency",
      "label": "Solvency ratio",
      "fmt": "x",
      "better": "high",
      "w": 1,
      "g": "strength",
      "tip": "As at 31 Mar 2025, IRDAI Annual Report 2024-25. Regulatory minimum is 1.5x."
    },
    {
      "k": "premium_5l_30",
      "label": "Indicative premium (Rs 5L, age 30)",
      "fmt": "inr",
      "better": "low",
      "w": 2,
      "g": "cost",
      "tip": "Annual premium for a 30-year-old, Rs 5 lakh individual cover. Left blank: premiums vary by city, variant and add-ons and no comparable cited source was found. Get a quote."
    },
    {
      "k": "ped_wait",
      "label": "Pre-existing disease wait",
      "fmt": "years",
      "better": "low",
      "w": 2,
      "g": "cost",
      "tip": "Standard waiting period before pre-existing illnesses are covered (plan documents / Ditto, Oct 2026). Some plans let you buy it down."
    },
    {
      "k": "restoration",
      "label": "Restoration of cover",
      "fmt": "yes",
      "better": "high",
      "w": 1,
      "g": "cover",
      "tip": "Built-in refill of sum insured after it is used up in a year (plan documents / Ditto, Oct 2026)."
    },
    {
      "k": "room_rent",
      "label": "Room rent limit",
      "fmt": "text",
      "better": null,
      "g": "cover",
      "tip": "Room category allowed without proportionate deductions (Oct 2026)."
    },
    {
      "k": "ncb",
      "label": "No-claim bonus",
      "fmt": "text",
      "better": null,
      "g": "cover",
      "tip": "How the sum insured grows for claim-free years (Oct 2026)."
    },
    {
      "k": "copay",
      "label": "Co-pay",
      "fmt": "text",
      "better": null,
      "g": "cover",
      "tip": "Share of each claim you pay yourself in the base plan (Oct 2026)."
    }
  ],
